{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "scenefit-backend", "region": "asia-southeast1" }
      },
      {
        "source": "/healthz",
        "run": { "serviceId": "scenefit-backend", "region": "asia-southeast1" }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  }
}

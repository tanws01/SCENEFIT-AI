# SCENEFIT AI - environment configuration (Google Cloud only)
#
# Every service defaults to deterministic offline "mock" mode so the app runs
# with zero network access. Set a service to "live" only in a deployed Google
# Cloud environment where the corresponding Google SDK and credentials are
# available. Copy this file to `.env` for local overrides (never commit `.env`).
#
# PRODUCTION SECRETS: do NOT put real secrets (API keys, service-account JSON)
# in this file or in `.env`. In production they are provided by Google Cloud
# Secret Manager and injected into the Cloud Run service at deploy time, e.g.
#   gcloud run deploy scenefit-backend \
#     --set-secrets GEMINI_API_KEY=scenefit-gemini-key:latest
#
# GOOGLE-ONLY: the only cloud / AI providers targeted are Google.

# ---- Adapter modes: mock (default, offline) | live (deployed Google Cloud) ----
GEMINI_MODE=mock          # Gemini language understanding + styling suggestions
VERTEX_IMAGE_MODE=mock    # Vertex AI image generation (virtual try-on)
SPEECH_MODE=mock          # Cloud Speech-to-Text (voice -> text)
FIRESTORE_MODE=mock       # Firestore (application + reference data)
STORAGE_MODE=mock         # Cloud Storage (authorised media assets)
BIGQUERY_MODE=mock        # BigQuery (aggregated retail analytics)
AUTH_MODE=mock            # Firebase Auth / Identity Platform

# ---- Google Cloud project / platform ----
GOOGLE_CLOUD_PROJECT=scenefit-demo
FIREBASE_PROJECT=scenefit-demo
# Path to a service-account key file for local "live" testing only. In Cloud
# Run / GKE this is unset and Application Default Credentials are used instead.
# Never commit a real key; secrets come from Secret Manager in production.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Gemini (Google AI Studio / Generative Language API) ----
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Secret Manager supplies GEMINI_API_KEY in production; never commit a real key.
# GEMINI_MODE=live requires GEMINI_API_KEY (else the adapter fails fast).
GEMINI_API_KEY=
# Default model; override to use the newest available id. Discover ids with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=gemini-2.5-flash

# ---- Vertex AI image generation / virtual try-on ----
VERTEX_LOCATION=asia-southeast1
VERTEX_IMAGE_MODEL=imagegeneration

# ---- Google Cloud Speech-to-Text ----
SPEECH_LANGUAGE_CODE=en-MY

# ---- Google Cloud Storage ----
GCS_BUCKET=scenefit-demo-assets

# ---- BigQuery ----
BIGQUERY_DATASET=scenefit_analytics

# ---- Server ----
# Cloud Run sets PORT at runtime; the server reads process.env.PORT || 8080.
PORT=8080
